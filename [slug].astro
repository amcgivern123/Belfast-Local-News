---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PromoteBand from '../../components/PromoteBand.astro';
import { getArticles, articleUrl, type Article } from '../../lib/content';
import { SITE, CATEGORIES, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, all: articles },
  }));
}

interface Props { article: Article; all: Article[] }
const { article, all } = Astro.props;
const { title, description, date, category, area, author, image, imageAlt } = article.data;
const { Content } = await render(article);

const url = new URL(articleUrl(article), SITE.url).href;
const related = all.filter((a) => a.data.category === category && a.id !== article.id).slice(0, 3);
const enc = encodeURIComponent;

// Structured data so Google can show the story in Top Stories / Google News
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: date.toISOString(),
    image: [new URL(image ?? SITE.defaultImage, SITE.url).href],
    author: [{ '@type': author === SITE.name ? 'Organization' : 'Person', name: author }],
    publisher: { '@type': 'NewsMediaOrganization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: new URL('/images/logo.png', SITE.url).href } },
    mainEntityOfPage: url,
    articleSection: CATEGORIES[category],
    ...(area ? { contentLocation: { '@type': 'Place', name: `${area}, Belfast` } } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: CATEGORIES[category], item: `${SITE.url}/category/${category}/` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---
<BaseLayout title={title} description={description} image={image} type="article" publishedTime={date} jsonLd={jsonLd}>
  <article class="article">
    <div class="tags">
      <a class="kicker" href={`/category/${category}/`}>{CATEGORIES[category]}</a>
      {area && <span class="meta">· {area}</span>}
    </div>
    <h1>{title}</h1>
    <p class="standfirst">{description}</p>
    <p class="byline">By {author} · <time datetime={date.toISOString()}>{formatDate(date)}</time></p>
    {image && (
      <figure>
        <img class="media-wide" src={image} alt={imageAlt ?? ''} fetchpriority="high" />
        {imageAlt && <figcaption>{imageAlt}</figcaption>}
      </figure>
    )}
    <div class="prose"><Content /></div>

    <div class="share" aria-label="Share this story">
      <strong>Share:</strong>
      <a href={`https://wa.me/?text=${enc(title + ' ' + url)}`} rel="noopener" target="_blank">WhatsApp</a>
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`} rel="noopener" target="_blank">Facebook</a>
      <a href={`https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(title)}`} rel="noopener" target="_blank">X</a>
      <a href={`mailto:?subject=${enc(title)}&body=${enc(url)}`}>Email</a>
    </div>
  </article>

  {related.length > 0 && (
    <section aria-labelledby="related-h" style="margin-top:48px">
      <div class="section-head"><h2 id="related-h">More {CATEGORIES[category]}</h2></div>
      <div class="grid">{related.map((a) => <ArticleCard article={a} />)}</div>
    </section>
  )}
  <div style="margin-top:48px"><PromoteBand /></div>
</BaseLayout>
